# ---------------------------------------------------------------------------
# Why This Match — environment variables
#
# Copy to `.env` in the repository root:
#
#   cp .env.example .env
#
# Rules:
# - `.env` is git-ignored and must never be committed.
# - Every variable below has a safe default, so `.env` is optional for local
#   development and CI.
# - Only variables prefixed with `VITE_` are included in the browser bundle.
#   Keep anything sensitive unprefixed, and therefore server-side.
# ---------------------------------------------------------------------------

# ------------------------------ apps/api -------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Address and port the Fastify server binds to.
API_HOST=127.0.0.1
API_PORT=4000

# Fastify/Pino log level:
# fatal | error | warn | info | debug | trace | silent
API_LOG_LEVEL=info

# Browser origins allowed to call the API (comma-separated). Add your deployed
# front-end origin here; anything else is refused by the CORS layer.
API_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string. Matches the credentials in docker-compose.yml.
# Start the database with `npm run db:up` (from the repository root).
DATABASE_URL=postgresql://wtm:wtm@127.0.0.1:5432/why_this_match?schema=public

# A separate database, used only by `npm run test:db`. It must never be the
# same database as DATABASE_URL: the test suite creates and deletes rows.
TEST_DATABASE_URL=postgresql://wtm:wtm@127.0.0.1:5432/why_this_match_test?schema=public

# ----------------------------- apps/web -------------------------------

# Base URL the browser calls. The app appends /api/v1/... to it.
# In development, an unset value falls back to http://127.0.0.1:4000.
# In a production build it must be set, or the client refuses to make requests.
VITE_API_URL=http://127.0.0.1:4000

# How long a single request may take before it is abandoned. Optional.
VITE_API_TIMEOUT_MS=8000
