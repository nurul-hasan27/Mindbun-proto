# ---------------------------------------------------------------------------
# Why This Match - environment variables
#
# Copy this file to `.env` in the repository root:
#
#   cp .env.example .env
#
# Rules:
# - `.env` is git-ignored and must never be committed.
# - Never commit real secrets. Only variables prefixed with `VITE_` reach the
#   browser bundle, so anything sensitive must stay server-side (apps/api).
# - Every variable below has a safe default, so `.env` is optional for local
#   development.
# ---------------------------------------------------------------------------

# ---------------------------- apps/api (server) -----------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Port and host the Fastify server binds to.
API_PORT=4000
API_HOST=127.0.0.1

# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGIN=http://localhost:5173

# Fastify log level: fatal | error | warn | info | debug | trace | silent
API_LOG_LEVEL=info

# Placeholder only. Phase 1 has no secrets; when a real key is needed it will
# be read on the server only, never prefixed with VITE_ and never committed.
# API_SECRET_KEY=

# ----------------------------- apps/web (client) ----------------------------

# Base URL of the API, used by the browser. Must start with VITE_ to be exposed.
VITE_API_BASE_URL=http://127.0.0.1:4000
