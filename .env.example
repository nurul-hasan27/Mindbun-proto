# ---------------------------------------------------------------------------
# Why This Match — environment variables
#
# Copy to `.env` in the repository root:
#
#   cp .env.example .env
#
# Rules:
# - `.env` is git-ignored and must never be committed.
# - Every variable below has a safe default, so `.env` is optional for local
#   development and CI.
# - Only variables prefixed with `VITE_` are ever included in the browser
#   bundle. Phase 1 has none: the web app makes no network calls, and the API
#   holds no secrets.
# ---------------------------------------------------------------------------

# ------------------------------ apps/api -------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Address and port the Fastify server binds to.
API_HOST=127.0.0.1
API_PORT=4000

# Fastify/Pino log level:
# fatal | error | warn | info | debug | trace | silent
API_LOG_LEVEL=info
